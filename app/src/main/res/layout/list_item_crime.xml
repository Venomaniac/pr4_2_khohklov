<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/list_crime_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Stolen yogurt"/>

        <TextView
            android:id="@+id/list_crime_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Fri, Mar 08, 2019"/>

        <TextView
            android:id="@+id/list_crime_suspect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Suspect: Bill Phillips, +1 555 0100"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/list_crime_solved"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="@string/crime_solved_label"
        android:src="@drawable/ic_solved"/>
</LinearLayout>
